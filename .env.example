# cms-gate configuration (no secrets here: those go in files, see secrets/ in docker-compose.yml).
# Copy to .env and fill in the <placeholders>. Every variable is described in the README.

# --- GitHub App (Settings → Developer settings → GitHub Apps → the App) ---
GITHUB_APP_ID=<app-id>
GITHUB_CLIENT_ID=<client-id>
GITHUB_INSTALLATION_ID=<installation-id>
GITHUB_ORG=arquivo
GITHUB_TEAM=sobre-editors
# Paths of the secret files (set in docker-compose.yml when run with Compose).
# GITHUB_CLIENT_SECRET_FILE=/run/secrets/github_client_secret
# GITHUB_PRIVATE_KEY_FILE=/run/secrets/github_private_key

# --- The CMS ---
# The exact origin the editors open the CMS at, which is the environment's site: scheme and host, no path, no
# trailing slash (https://sobre.arquivo.pt, https://preprod.sobre.arquivo.pt or https://dev.sobre.arquivo.pt).
CMS_ORIGIN=https://<site-host>

# --- Listener (defaults: 127.0.0.1:8787; the image sets 0.0.0.0 and Compose publishes it on 127.0.0.1 only) ---
# LISTEN_HOST=127.0.0.1
# LISTEN_PORT=8787
# TRUST_PROXY=true

# --- Media bucket on the Ceph RGW ---
S3_ENDPOINT=https://<rgw-host>
# S3_REGION=us-east-1
S3_BUCKET=sobre-media
S3_PREFIX=media/
# S3_ACCESS_KEY_ID_FILE=/run/secrets/s3_access_key_id
# S3_SECRET_ACCESS_KEY_FILE=/run/secrets/s3_secret_access_key
# PEM bundle for the RGW's certificate, if it is signed by a private CA (replaces the system CAs).
# S3_CA_FILE=/run/secrets/s3_ca

# --- Limits ---
# MAX_UPLOAD_BYTES=52428800
# RATE_SIGNINS_PER_MINUTE=10
# RATE_REQUESTS_PER_MINUTE=120
# RATE_UPLOADS_PER_HOUR=100
# RATE_UPLOAD_BYTES_PER_HOUR=1073741824
# TEAM_CACHE_SECONDS=300
